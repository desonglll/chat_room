{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": {
    "name": "ChatRoom Echo Gate",
    "version": "1.0.0"
  },
  "color": {
    "brand": {
      "jade-50": { "$value": "#F0FBF7", "$type": "color" },
      "jade-100": { "$value": "#DDF4EC", "$type": "color" },
      "jade-200": { "$value": "#B8E5D7", "$type": "color" },
      "jade-300": { "$value": "#7DCDB9", "$type": "color" },
      "jade-400": { "$value": "#39B395", "$type": "color" },
      "jade-500": { "$value": "#11947B", "$type": "color" },
      "jade-700": { "$value": "#087F6B", "$type": "color" },
      "jade-800": { "$value": "#066456", "$type": "color" },
      "jade-900": { "$value": "#064E44", "$type": "color" },
      "coral-100": { "$value": "#FFE5E0", "$type": "color" },
      "coral-500": { "$value": "#FF6B57", "$type": "color" },
      "coral-700": { "$value": "#B9362B", "$type": "color" },
      "sun-100": { "$value": "#FFF2CE", "$type": "color" },
      "sun-500": { "$value": "#F4B942", "$type": "color" },
      "sun-800": { "$value": "#8A5B00", "$type": "color" },
      "ink-950": { "$value": "#172321", "$type": "color" },
      "paper-50": { "$value": "#F7FAF9", "$type": "color" }
    },
    "neutral": {
      "0": { "$value": "#FFFFFF", "$type": "color" },
      "50": { "$value": "#F7FAF9", "$type": "color" },
      "100": { "$value": "#EEF4F1", "$type": "color" },
      "200": { "$value": "#DCE6E2", "$type": "color" },
      "300": { "$value": "#C4D1CD", "$type": "color" },
      "500": { "$value": "#758681", "$type": "color" },
      "700": { "$value": "#52615D", "$type": "color" },
      "900": { "$value": "#263330", "$type": "color" },
      "950": { "$value": "#172321", "$type": "color" }
    },
    "light": {
      "canvas": { "$value": "{color.neutral.50}", "$type": "color" },
      "surface": { "$value": "{color.neutral.0}", "$type": "color" },
      "surface-subtle": { "$value": "{color.neutral.100}", "$type": "color" },
      "border": { "$value": "{color.neutral.200}", "$type": "color" },
      "text": { "$value": "{color.neutral.950}", "$type": "color" },
      "text-muted": { "$value": "{color.neutral.700}", "$type": "color" },
      "primary": { "$value": "{color.brand.jade-700}", "$type": "color" },
      "primary-hover": { "$value": "{color.brand.jade-800}", "$type": "color" },
      "primary-soft": { "$value": "{color.brand.jade-100}", "$type": "color" },
      "accent": { "$value": "{color.brand.coral-500}", "$type": "color" },
      "warning": { "$value": "{color.brand.sun-800}", "$type": "color" },
      "danger": { "$value": "{color.brand.coral-700}", "$type": "color" }
    },
    "dark": {
      "canvas": { "$value": "#111817", "$type": "color" },
      "surface": { "$value": "#172321", "$type": "color" },
      "surface-raised": { "$value": "#21302D", "$type": "color" },
      "border": { "$value": "#34443F", "$type": "color" },
      "text": { "$value": "#F4F8F6", "$type": "color" },
      "text-muted": { "$value": "#A8B8B3", "$type": "color" },
      "primary": { "$value": "#39BFA6", "$type": "color" },
      "primary-soft": { "$value": "#123E35", "$type": "color" },
      "accent": { "$value": "#FF806E", "$type": "color" }
    }
  },
  "font": {
    "family": {
      "sans": { "$value": "Inter, PingFang SC, Microsoft YaHei, system-ui, sans-serif", "$type": "fontFamily" }
    },
    "size": {
      "caption": { "$value": "0.75rem", "$type": "dimension" },
      "body-sm": { "$value": "0.875rem", "$type": "dimension" },
      "body": { "$value": "1rem", "$type": "dimension" },
      "title-sm": { "$value": "1.25rem", "$type": "dimension" },
      "title": { "$value": "1.75rem", "$type": "dimension" },
      "display": { "$value": "2.5rem", "$type": "dimension" }
    }
  },
  "space": {
    "1": { "$value": "0.25rem", "$type": "dimension" },
    "2": { "$value": "0.5rem", "$type": "dimension" },
    "3": { "$value": "0.75rem", "$type": "dimension" },
    "4": { "$value": "1rem", "$type": "dimension" },
    "5": { "$value": "1.25rem", "$type": "dimension" },
    "6": { "$value": "1.5rem", "$type": "dimension" },
    "8": { "$value": "2rem", "$type": "dimension" },
    "12": { "$value": "3rem", "$type": "dimension" },
    "16": { "$value": "4rem", "$type": "dimension" }
  },
  "radius": {
    "xs": { "$value": "0.25rem", "$type": "dimension" },
    "sm": { "$value": "0.375rem", "$type": "dimension" },
    "md": { "$value": "0.5rem", "$type": "dimension" },
    "round": { "$value": "999px", "$type": "dimension" }
  },
  "size": {
    "icon-inline": { "$value": "1rem", "$type": "dimension" },
    "icon-button": { "$value": "1.125rem", "$type": "dimension" },
    "control": { "$value": "2.5rem", "$type": "dimension" },
    "touch": { "$value": "2.75rem", "$type": "dimension" },
    "sidebar": { "$value": "21.25rem", "$type": "dimension" }
  },
  "motion": {
    "fast": { "$value": "120ms", "$type": "duration" },
    "normal": { "$value": "200ms", "$type": "duration" },
    "ease-out": { "$value": [0.2, 0.8, 0.2, 1], "$type": "cubicBezier" }
  }
}
