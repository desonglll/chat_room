# Local Compose defaults. Use a long random password outside local development.
POSTGRES_DB=chatroom
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_VOLUME_NAME=chatroom_postgres_data

CHAT_ROOM_PORT=3000
CHAT_ROOM_FRONTEND=react
CHAT_ROOM_ADMIN_USERNAMES=
RUST_LOG=chat_room=info,tower_http=info

# Set the backend image and the selected frontend image to published GHCR tags
# to run without building locally. CHAT_ROOM_FRONTEND accepts react or vue.
# CHAT_ROOM_BACKEND_IMAGE=ghcr.io/desonglll/chat_room-backend:latest
# CHAT_ROOM_FRONTEND_IMAGE=ghcr.io/desonglll/chat_room-frontend-react:latest
# CHAT_ROOM_FRONTEND_IMAGE=ghcr.io/desonglll/chat_room-frontend-vue:latest
