# Local Compose defaults. Use a long random password outside local development.
POSTGRES_DB=chatroom
POSTGRES_USER=chatroom
POSTGRES_PASSWORD=chatroom

CHAT_ROOM_PORT=3000
CHAT_ROOM_ADMIN_USERNAMES=
CHAT_ROOM_DATABASE_URL=postgresql://chatroom:chatroom@127.0.0.1:52735/chatroom
CHAT_ROOM_REDIS_URL=redis://127.0.0.1:6379/
CHAT_ROOM_VECTOR_ENABLED=true
CHAT_ROOM_VECTOR_URL=http://127.0.0.1:6333
CHAT_ROOM_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
CHAT_ROOM_EMBEDDING_MODEL=BAAI/bge-m3
CHAT_ROOM_EMBEDDING_DIMENSIONS=1024
CHAT_ROOM_EMBEDDING_API_KEY_ENV=CHAT_ROOM_AI_API_KEY
CHAT_ROOM_VECTOR_TOP_K=12
# Required when [ai].enabled=true in chat-room.toml. Never commit a real key.
CHAT_ROOM_AI_API_KEY=
CHAT_ROOM_AI_ENABLED=true
CHAT_ROOM_AI_PROVIDER=openai
CHAT_ROOM_AI_MODEL=deepseek-ai/DeepSeek-V4-Flash
CHAT_ROOM_AI_BASE_URL=https://api.siliconflow.cn/v1
RUST_LOG=chat_room=info,tower_http=info

# Set this to a published GHCR or Docker Hub tag to run without building locally.
# CHAT_ROOM_IMAGE=ghcr.io/desonglll/chat_room:latest
CHAT_ROOM_IMAGE=docker.io/desonglll/chat_room:latest
# CHAT_ROOM_IMAGE=<dockerhub-username>/chat_room:latest
