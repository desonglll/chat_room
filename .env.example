# Local Compose defaults. Use a long random password outside local development.
POSTGRES_DB=chatroom
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_VOLUME_NAME=chatroom_postgres_data

CHAT_ROOM_PORT=3000
CHAT_ROOM_ADMIN_USERNAMES=
RUST_LOG=chat_room=info,tower_http=info

# Set both variables to published GHCR tags to run without building locally.
# CHAT_ROOM_BACKEND_IMAGE=ghcr.io/desonglll/chat_room-backend:latest
# CHAT_ROOM_FRONTEND_IMAGE=ghcr.io/desonglll/chat_room-frontend:latest
