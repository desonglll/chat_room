# Host-local defaults. docker-compose.yaml replaces localhost dependency URLs
# with Compose service names inside the chatroom container.
# Use a long random password outside local development.
POSTGRES_DB=chatroom
POSTGRES_USER=chatroom
POSTGRES_PASSWORD=chatroom

CHAT_ROOM_PORT=3000
# Deprecated one-time upgrade import. Use `server bootstrap-admin` for new deployments.
CHAT_ROOM_ADMIN_USERNAMES=
# Optional runtime overrides. Uncomment only values that should take precedence
# over chat-room.toml.
# CHAT_ROOM_ADMIN_ORPHAN_RETENTION_HOURS=168
# CHAT_ROOM_ADMIN_DELETED_ROOM_RETENTION_DAYS=30
# CHAT_ROOM_UPLOADS_MAX_FILE_SIZE_MIB=512
# CHAT_ROOM_UPLOADS_CHUNK_SIZE_MIB=8
# CHAT_ROOM_UPLOADS_ABANDONED_UPLOAD_GC_HOURS=24
# CHAT_ROOM_ATTACHMENTS_DIRECTORY=chat_attachments
# CHAT_ROOM_OSS_ENABLED=false
# CHAT_ROOM_OSS_LOCAL_MIRROR_ENABLED=false
# CHAT_ROOM_OSS_DIRECT_UPLOAD_ENABLED=false
# CHAT_ROOM_OSS_PRESIGN_EXPIRY_SECS=900
# CHAT_ROOM_OSS_OPERATION_TIMEOUT_SECS=30
# CHAT_ROOM_OSS_PRESIGN_ENDPOINT=
# CHAT_ROOM_OSS_PRESIGN_ADDRESSING_STYLE=virtual
# CHAT_ROOM_OSS_ENDPOINT=
# CHAT_ROOM_OSS_BUCKET=
# CHAT_ROOM_OSS_ACCESS_KEY_ID=
# CHAT_ROOM_OSS_ACCESS_KEY_SECRET=
# CHAT_ROOM_OSS_ROOT=/
# CHAT_ROOM_DATABASE_KIND=sqlite
# CHAT_ROOM_DATABASE_SQLITE_PATH=chat_rooms.db
# CHAT_ROOM_DATABASE_MAX_CONNECTIONS=10
CHAT_ROOM_DATABASE_URL=postgresql://chatroom:chatroom@127.0.0.1:52735/chatroom
CHAT_ROOM_REDIS_URL=redis://127.0.0.1:6379/
# CHAT_ROOM_REDIS_ENABLED=true
# CHAT_ROOM_REDIS_KEY_PREFIX=chat-room
# CHAT_ROOM_REDIS_CONNECT_TIMEOUT_MS=1500
# CHAT_ROOM_REDIS_COMMAND_TIMEOUT_MS=500
# CHAT_ROOM_REDIS_MESSAGE_TTL_SECS=30
# CHAT_ROOM_WORK_QUEUE_MESSAGE_CONCURRENCY=32
# CHAT_ROOM_WORK_QUEUE_UPLOAD_CONCURRENCY=4
# CHAT_ROOM_WORK_QUEUE_WAIT_TIMEOUT_SECS=30
# Web Push is disabled until a matching VAPID key pair and contact subject are configured.
# Generate URL-safe, unpadded VAPID keys with a trusted Web Push tool.
# CHAT_ROOM_WEB_PUSH_ENABLED=false
# CHAT_ROOM_WEB_PUSH_PUBLIC_KEY=
# CHAT_ROOM_WEB_PUSH_PRIVATE_KEY=
# CHAT_ROOM_WEB_PUSH_SUBJECT=mailto:admin@example.com
# CHAT_ROOM_WEB_PUSH_ALLOWED_ENDPOINT_HOSTS=fcm.googleapis.com,updates.push.services.mozilla.com,web.push.apple.com,notify.windows.com
# CHAT_ROOM_WEB_PUSH_POLL_INTERVAL_MS=1000
# CHAT_ROOM_WEB_PUSH_REQUEST_TIMEOUT_SECS=10
# CHAT_ROOM_WEB_PUSH_MAX_ATTEMPTS=5
# CHAT_ROOM_REALTIME_POLL_INTERVAL_MS=250
# CHAT_ROOM_REALTIME_HEARTBEAT_INTERVAL_SECS=15
# CHAT_ROOM_REALTIME_AUTH_TIMEOUT_SECS=10
# CHAT_ROOM_REALTIME_HISTORY_REPLAY_LIMIT=100
# CHAT_ROOM_REALTIME_MESSAGE_POLL_LIMIT=200
# CHAT_ROOM_REALTIME_POKE_COOLDOWN_SECS=5
# CHAT_ROOM_AUTH_SESSION_LIFETIME_DAYS=30
# CHAT_ROOM_AUTH_REGISTRATION_MODE=open
# CHAT_ROOM_AUTH_RATE_LIMIT_WINDOW_SECS=60
# CHAT_ROOM_AUTH_RATE_LIMIT_IP_ATTEMPTS=60
# CHAT_ROOM_AUTH_RATE_LIMIT_ACCOUNT_ATTEMPTS=10
# Comma-separated exact origins; empty is same-origin only.
# CHAT_ROOM_CORS_ALLOWED_ORIGINS=https://chat.example.com
# Enable only behind a proxy that sanitizes forwarding headers.
# CHAT_ROOM_TRUST_PROXY_HEADERS=false
CHAT_ROOM_VECTOR_ENABLED=true
CHAT_ROOM_VECTOR_URL=http://127.0.0.1:6333
# CHAT_ROOM_VECTOR_COLLECTION=chat_messages
# CHAT_ROOM_VECTOR_API_KEY_ENV=CHAT_ROOM_VECTOR_API_KEY
# CHAT_ROOM_VECTOR_API_KEY=
CHAT_ROOM_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
CHAT_ROOM_EMBEDDING_MODEL=BAAI/bge-m3
CHAT_ROOM_EMBEDDING_DIMENSIONS=1024
CHAT_ROOM_EMBEDDING_API_KEY_ENV=CHAT_ROOM_AI_API_KEY
CHAT_ROOM_VECTOR_TOP_K=6
CHAT_ROOM_VECTOR_SCORE_THRESHOLD=0.35
CHAT_ROOM_RERANK_ENABLED=true
CHAT_ROOM_RERANK_BASE_URL=https://api.siliconflow.cn/v1
CHAT_ROOM_RERANK_MODEL=BAAI/bge-reranker-v2-m3
CHAT_ROOM_RERANK_API_KEY_ENV=CHAT_ROOM_AI_API_KEY
CHAT_ROOM_RERANK_TIMEOUT_MS=2000
CHAT_ROOM_RERANK_SCORE_THRESHOLD=0.35
# CHAT_ROOM_VECTOR_WORKER_INTERVAL_MS=500
# Required when [ai].enabled=true in chat-room.toml. Never commit a real key.
CHAT_ROOM_AI_API_KEY=
CHAT_ROOM_AI_ENABLED=true
CHAT_ROOM_AI_PROVIDER=openai
# CHAT_ROOM_AI_API_KEY_ENV=CHAT_ROOM_AI_API_KEY
CHAT_ROOM_AI_MODEL=deepseek-ai/DeepSeek-V4-Flash
CHAT_ROOM_AI_BASE_URL=https://api.siliconflow.cn/v1
CHAT_ROOM_AI_FAST_MODEL=deepseek-ai/DeepSeek-V3.2
CHAT_ROOM_AI_STANDARD_EXTRA_BODY={"enable_thinking":false}
CHAT_ROOM_AI_REASONING_EXTRA_BODY={"reasoning_effort":"high"}
# Extra-body values use JSON object syntax, for example {"temperature":0.2}.
# CHAT_ROOM_AI_STANDARD_EXTRA_BODY=
# CHAT_ROOM_AI_REASONING_EXTRA_BODY=
# CHAT_ROOM_AI_MAX_CONTEXT_MESSAGES=30
# CHAT_ROOM_AI_ANALYSIS_CONTEXT_MESSAGES=5000
# CHAT_ROOM_AI_REQUEST_TIMEOUT_SECS=60
# CHAT_ROOM_AI_STREAM_IDLE_TIMEOUT_SECS=30
# CHAT_ROOM_AI_STREAM_TOTAL_TIMEOUT_SECS=300
# CHAT_ROOM_AI_SUGGEST_COOLDOWN_SECS=10
RUST_LOG=chat_room=info,tower_http=info

# Set this to a published GHCR or Docker Hub tag to run without building locally.
# CHAT_ROOM_IMAGE=ghcr.io/desonglll/chat_room:latest
CHAT_ROOM_IMAGE=docker.io/desonglll/chat_room:latest
# CHAT_ROOM_IMAGE=<dockerhub-username>/chat_room:latest
